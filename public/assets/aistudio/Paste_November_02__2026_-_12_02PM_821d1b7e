const generateMathProblem = (level) => {
    if (level === 'baby') return null;

    let maxAdd = 5;
    let allowMinus = false;

    if (level === 'kitten') maxAdd = 5;
    if (level === 'teen') maxAdd = 10;
    if (level === 'adult') maxAdd = 15;
    if (level === 'smart') {
        maxAdd = 15;
        allowMinus = true;
    }

    const isMinus = allowMinus && Math.random() > 0.5;

    if (isMinus) {
        const result = Math.floor(Math.random() * 6); // 0..5
        const a = Math.floor(Math.random() * (10 - result + 1)) + result; 
        const b = a - result;
        return { q: `${a} - ${b}`, a: NUMBER_WORDS[result] };
    } else {
        const sum = Math.floor(Math.random() * maxAdd) + 1; 
        const a = Math.floor(Math.random() * (sum + 1));
        const b = sum - a;
        return { q: `${a} + ${b}`, a: NUMBER_WORDS[sum] };
    }
};

