        <path d="M140,150 Q170,120 160,90 T140,60" fill="none" stroke="#FF9A00" strokeWidth="12" strokeLinecap="round" className={`origin-bottom-left transition-all duration-1000 ${['dance', 'shake', 'run', 'sway'].includes(action) ? 'animate-wiggle' : ''}`}/>
        {action === 'lying' ? (<ellipse cx="100" cy="160" rx="70" ry="30" fill="#FFB347" />) : (<ellipse cx="100" cy="140" rx="50" ry="60" fill="#FFB347" />)}
        {action !== 'lying' && <ellipse cx="100" cy="145" rx="25" ry="35" fill="#FFE5B4" />}
        {stage === 'baby' && action !== 'lying' && (<path d="M70,150 Q100,190 130,150 Q120,130 100,130 Q80,130 70,150" fill="white" stroke="#DDD" strokeWidth="2"/>)}
        <g className={`transition-transform duration-500 ${action === 'eating' ? 'translate-y-4' : ''} ${action === 'bow' ? 'translate-y-8 rotate-12' : ''}`}>
          <circle cx="100" cy="80" r="45" fill="#FFB347" />
          <path d="M65,50 L55,10 L85,40 Z" fill="#FFB347" />
          <path d="M135,50 L145,10 L115,40 Z" fill="#FFB347" />
          {stage === 'baby' && (<g transform="translate(100, 35)"><path d="M-15,-10 L0,0 L-15,10 Z" fill="pink" /><path d="M15,-10 L0,0 L15,10 Z" fill="pink" /><circle cx="0" cy="0" r="3" fill="#E91E63" /></g>)}
          {stage === 'teen' && <path d="M90,35 Q100,20 110,35" fill="none" stroke="#FF9A00" strokeWidth="3" />}
          {action === 'sleeping' || action === 'blink' || action === 'love' || action === 'bow' ? (
            <>
              {action === 'love' ? (<><text x="75" y="85" fontSize="20">❤️</text><text x="105" y="85" fontSize="20">❤️</text></>) : (
                <>
                  <path d="M80,75 Q90,80 100,75" fill="none" stroke="#333" strokeWidth="3" />
                  <path d="M120,75 Q110,80 100,75" fill="none" stroke="#333" strokeWidth="3" />
                </>
              )}
            </>
          ) : (
            <>
              <circle cx="85" cy="75" r={stage === 'baby' || stage === 'kitten' ? 7 : 5} fill="#333" />
              <circle cx="115" cy="75" r={stage === 'baby' || stage === 'kitten' ? 7 : 5} fill="#333" />
              <circle cx={stage === 'baby' || stage === 'kitten' ? 88 : 87} cy="73" r="2" fill="white" />
              <circle cx={stage === 'baby' || stage === 'kitten' ? 118 : 117} cy="73" r="2" fill="white" />
            </>
          )}
          {stage === 'smart' && (<g opacity="0.8"><circle cx="85" cy="75" r="14" fill="none" stroke="#333" strokeWidth="2" /><circle cx="115" cy="75" r="14" fill="none" stroke="#333" strokeWidth="2" /><line x1="99" y1="75" x2="101" y2="75" stroke="#333" strokeWidth="2" /></g>)}
          <circle cx="100" cy="90" r="3" fill="pink" />
          {action === 'eating' ? (<circle cx="100" cy="98" r="5" fill="#333" />) : (<path d="M90,95 Q100,105 110,95" fill="none" stroke="#333" strokeWidth="2" strokeLinecap="round" />)}
          <line x1="60" y1="90" x2="40" y2="85" stroke="#333" strokeWidth="1" />
          <line x1="60" y1="95" x2="40" y2="95" stroke="#333" strokeWidth="1" />
          <line x1="140" y1="90" x2="160" y2="85" stroke="#333" strokeWidth="1" />
          <line x1="140" y1="95" x2="160" y2="95" stroke="#333" strokeWidth="1" />
        </g>
        {stage === 'smart' && action !== 'lying' && (<g transform="translate(100, 130)"><path d="M-10,-5 L0,0 L-10,5 Z" fill="#D32F2F" /><path d="M10,-5 L0,0 L10,5 Z" fill="#D32F2F" /><circle cx="0" cy="0" r="2" fill="#B71C1C" /></g>)}
        {action === 'lying' ? (<><ellipse cx="60" cy="160" rx="10" ry="15" fill="#FFF" /><ellipse cx="140" cy="160" rx="10" ry="15" fill="#FFF" /></>) : (<><ellipse cx="80" cy="180" rx="12" ry="10" fill="#FFF" /><ellipse cx="120" cy="180" rx="12" ry="10" fill="#FFF" />{action === 'run' ? (<><ellipse cx="60" cy="130" rx="10" ry="20" fill="#FF9A00" className="animate-pulse"/><ellipse cx="140" cy="130" rx="10" ry="20" fill="#FF9A00" /></>) : (<><ellipse cx="80" cy="130" rx="10" ry="20" fill="#FF9A00" /><ellipse cx="120" cy="130" rx="10" ry="20" fill="#FF9A00" /></>)}</>)}
        {activeEmoji && (<g className="animate-fade-in-up"><circle cx="160" cy="40" r="25" fill="white" opacity="0.8" /><text x="160" y="50" fontSize="30" textAnchor="middle" className="animate-bounce">{activeEmoji}</text></g>)}
        {action === 'sleeping' && !activeEmoji && (<text x="150" y="50" className="text-4xl font-bold fill-blue-500 opacity-70 animate-ping">Zzz</text>)}
        {action === 'run' && (<text x="20" y="150" className="text-xl fill-gray-400 animate-pulse">💨</text>)}
      </svg>
    </div>
  );
};

const KEYBOARD_LAYOUT = [
  ['Ё', '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '='],
  ['Й', 'Ц', 'У', 'К', 'Е', 'Н', 'Г', 'Ш', 'Щ', 'З', 'Х', 'Ъ'],
  ['Ф', 'Ы', 'В', 'А', 'П', 'Р', 'О', 'Л', 'Д', 'Ж', 'Э'],
  ['Я', 'Ч', 'С', 'М', 'И', 'Т', 'Ь', 'Б', 'Ю', '.']
];

const App = () => {
  const [stats, setStats] = useState({ hunger: 10, sleep: 10, clean: 10, happiness: 10, intelligence: 10 });
  const [xp, setXp] = useState(0);
  const [level, setLevel] = useState('baby'); 
  const [currentWord, setCurrentWord] = useState('');
  const [currentCategory, setCurrentCategory] = useState('COMMANDS');
  const [currentCategoryIndex, setCurrentCategoryIndex] = useState(0);
  const [typedChars, setTypedChars] = useState('');
  const [catAction, setCatAction] = useState('idle');
  const [lastInteractionTime, setLastInteractionTime] = useState(Date.now());
  const [hintKey, setHintKey] = useState(null);
  const [combo, setCombo] = useState(0);
  const [message, setMessage] = useState("Напечатай слово!");
  const [showLevelUp, setShowLevelUp] = useState(false);
  const [showCustomInput, setShowCustomInput] = useState(false);
  const [customInputValue, setCustomInputValue] = useState('');
  const [customHistory, setCustomHistory] = useState([]);
  const [aiLoading, setAiLoading] = useState(false);
  const [waitingForConfirmation, setWaitingForConfirmation] = useState(false); 
  const [showHelp, setShowHelp] = useState(false);
  
  const [wordsTypedCount, setWordsTypedCount] = useState(0);
  const [isQuizMode, setIsQuizMode] = useState(false);
  const [soundEnabled, setSoundEnabled] = useState(true);
  
  const [wordAudioUrl, setWordAudioUrl] = useState(null);
  const [messageAudioUrl, setMessageAudioUrl] = useState(null);
  const [isWordAudioLoading, setIsWordAudioLoading] = useState(false);
  const [isRecording, setIsRecording] = useState(false); 
  const [isPlaying, setIsPlaying] = useState(false);
  
  const [isMobileMode, setIsMobileMode] = useState(false);
  const [kbScale, setKbScale] = useState(1);
  
  const [isRewardMode, setIsRewardMode] = useState(false); 
  const [rewardSeconds, setRewardSeconds] = useState(0); 
  const [sessionWordCount, setSessionWordCount] = useState(0); 
  const [isRewardTimerActive, setIsRewardTimerActive] = useState(false); 
  const [isTimerRunning, setIsTimerRunning] = useState(false); 

  const timerRef = useRef(null);
  const wordStartTimeRef = useRef(0);
  const mediaRecorderRef = useRef(null);
  const chunksRef = useRef([]);
  const apiKey = ""; 
  const fileInputRef = useRef(null);

  // --- CSS Injection ---
  useEffect(() => {
    const style = document.createElement('style');
    style.textContent = `
      @keyframes wiggle { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } }
      @keyframes sway { 0%, 100% { transform: rotate(-3deg) translateX(-5px); } 50% { transform: rotate(3deg) translateX(5px); } }
      @keyframes spin-slow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
      @keyframes bounce-high { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-25px); } }
      .animate-wiggle { animation: wiggle 1s ease-in-out infinite; }
      .animate-sway { animation: sway 2s ease-in-out infinite; }
      .animate-spin-slow { animation: spin-slow 1s linear; }
      .animate-bounce-high { animation: bounce-high 0.5s ease-in-out infinite; }
      .animate-fade-in-up { animation: fadeInUp 0.5s ease-out; }
      @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    `;
    document.head.appendChild(style);
    return () => document.head.removeChild(style);
  }, []);

  // --- SAVING ---
  useEffect(() => {
    const savedData = localStorage.getItem('typecat_save_v29'); 
    if (savedData) {
      try {
        const parsed = JSON.parse(savedData);
        setStats(parsed.stats);
        setXp(parsed.xp);
        setLevel(parsed.level);
        if (parsed.customHistory) setCustomHistory(parsed.customHistory);
        if (parsed.wordsTypedCount) setWordsTypedCount(parsed.wordsTypedCount);
        if (parsed.soundEnabled !== undefined) setSoundEnabled(parsed.soundEnabled);
        if (parsed.currentCategoryIndex !== undefined) setCurrentCategoryIndex(parsed.currentCategoryIndex);
        if (parsed.kbScale) setKbScale(parsed.kbScale);
        if (parsed.rewardSeconds) setRewardSeconds(parsed.rewardSeconds);
      } catch (e) { console.error(e); }
    } else {
        setMessage("Привет! Я твой котик! 🐱 Помоги мне вырасти и стать умнее! Печатай слова, решай задачки и не забывай про режим тренировки за награду! Мяу!");
    }
  }, []);

  useEffect(() => {
    const dataToSave = { stats, xp, level, customHistory, wordsTypedCount, soundEnabled, currentCategoryIndex, kbScale, rewardSeconds };
    localStorage.setItem('typecat_save_v29', JSON.stringify(dataToSave));
  }, [stats, xp, level, customHistory, wordsTypedCount, soundEnabled, currentCategoryIndex, kbScale, rewardSeconds]);

  // --- REWARD TIMER LOGIC ---
  useEffect(() => {
    let interval = null;
    if (isTimerRunning && rewardSeconds > 0) {
        interval = setInterval(() => {
            setRewardSeconds(prev => {
                if (prev <= 1) {
                    setIsTimerRunning(false);
                    playAlarm();
                    return 0;
                }
                return prev - 1;
            });
        }, 1000);
    }
    return () => clearInterval(interval);
  }, [isTimerRunning, rewardSeconds]);

  const handleRewardToggle = () => {
      if (isRewardMode) {
          setIsRewardMode(false);
          setIsRewardTimerActive(true);
          setSessionWordCount(0);
      } else {
          setIsRewardMode(true);
          setIsRewardTimerActive(false);
          setSessionWordCount(0);
          setMessage("Тренировка! Копим секунды!");
      }
  };

  const handleExport = async () => {
      const data = { stats, xp, level, customHistory, wordsTypedCount, currentCategoryIndex, kbScale, rewardSeconds };
      const audioData = await getAllAudioFromDB();
      const audioBase64 = {};
      for (const key in audioData) {
          const blob = audioData[key];
          const reader = new FileReader();
          await new Promise(resolve => {
              reader.onloadend = () => {
                  audioBase64[key] = reader.result; 
                  resolve();
              };
              reader.readAsDataURL(blob);
          });
      }
      data.audio = audioBase64;
      const json = JSON.stringify(data);
      const blob = new Blob([json], {type: "application/json"});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = "typecat_save.json";
      a.click();
  };

  const handleImportClick = () => {
      fileInputRef.current.click();
  };

  const handleImportFile = (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async (evt) => {
          try {
              const parsed = JSON.parse(evt.target.result);
              if (parsed.stats) setStats(parsed.stats);
              if (parsed.xp) setXp(parsed.xp);
              if (parsed.level) setLevel(parsed.level);
              if (parsed.customHistory) setCustomHistory(parsed.customHistory);
              if (parsed.wordsTypedCount) setWordsTypedCount(parsed.wordsTypedCount);
              if (parsed.kbScale) setKbScale(parsed.kbScale);
              if (parsed.rewardSeconds) setRewardSeconds(parsed.rewardSeconds);
              
              if (parsed.audio) {
                  for (const key in parsed.audio) {
                      const dataURL = parsed.audio[key];
                      const res = await fetch(dataURL);
                      const blob = await res.blob();
                      saveAudioToDB(key, blob);
                  }
              }
              setMessage("Прогресс загружен!");
          } catch (err) {
              console.error(err);
              setMessage("Ошибка загрузки файла");
          }
      };
      reader.readAsText(file);
  };

  const handleRecordToggle = async () => {
    if (isRecording) {
        if (mediaRecorderRef.current && mediaRecorderRef.current.state !== 'inactive') {
            mediaRecorderRef.current.stop();
        }
        setIsRecording(false);
    } else {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            let mimeType = 'audio/webm';
            if (!MediaRecorder.isTypeSupported(mimeType)) {
                mimeType = 'audio/mp4'; 
                if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = 'audio/ogg'; 
            }

            mediaRecorderRef.current = new MediaRecorder(stream, { mimeType });
            chunksRef.current = [];

            mediaRecorderRef.current.ondataavailable = (e) => {
                if (e.data.size > 0) chunksRef.current.push(e.data);
            };

            mediaRecorderRef.current.onstop = () => {
                const blob = new Blob(chunksRef.current, { type: mediaRecorderRef.current.mimeType });
                const normalizedKey = currentWord.charAt(0).toUpperCase() + currentWord.slice(1).toLowerCase();
                saveAudioToDB(normalizedKey, blob);
                playAudio(normalizedKey); 
            };
            mediaRecorderRef.current.start();
            setIsRecording(true);
            setMessage("Идет запись...");
        } catch (err) {
            console.error(err);
            setMessage("Нужен доступ к микрофону!");
        }
    }
  };

  // --- UNIFIED AUDIO PLAYER ---
  const speakText = (text) => {
      if (!soundEnabled) return;
      window.speechSynthesis.cancel();
      const normalized = text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
      const utterance = new SpeechSynthesisUtterance(normalized);
      utterance.lang = 'ru-RU'; 
      utterance.rate = 0.9; 
      utterance.pitch = 1.1; 
      const voices = window.speechSynthesis.getVoices();
      const ruVoice = voices.find(v => v.lang === 'ru-RU' && v.name.includes('Google')) || voices.find(v => v.lang === 'ru-RU');
      if (ruVoice) { utterance.voice = ruVoice; }
      utterance.onstart = () => setIsPlaying(true);
      utterance.onend = () => setIsPlaying(false);
      window.speechSynthesis.speak(utterance);
  };

  const playAudio = async (text) => {
      if (!text || !soundEnabled) return;
      let normalizedKey = text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
      const userBlob = await getAudioFromDB(normalizedKey);
      if (userBlob) {
          setIsPlaying(true);
          const url = URL.createObjectURL(userBlob);
          const audio = new Audio(url);
          audio.onended = () => setIsPlaying(false);
          audio.play().catch(e => { console.log("Audio play prevented", e); setIsPlaying(false); });
      } else {
          speakText(text);
      }
  };

  const callGemini = async (prompt) => {
    setAiLoading(true);
    try {
      const response = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`,
        { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] }) }
      );
      if (!response.ok) throw new Error('API Error');
      const data = await response.json();
      return data.candidates?.[0]?.content?.parts?.[0]?.text || "Мяу?";
    } catch (error) { return "Мяу... нет связи!"; } finally { setAiLoading(false); }
  };

  const handleCatThought = async () => {
    if (!soundEnabled) { setMessage("Думаю..."); const thought = await callGemini(`Ты - котенок. Придумай смешную фразу (макс 8 слов) на русском языке для ребенка.`); setMessage(thought); return; }
    setMessage("Думаю...");
    const thought = await callGemini(`Ты - котенок. Придумай смешную фразу (макс 8 слов) на русском языке для ребенка.`);
    setMessage(thought);
    playAudio(thought);
  };

  const handleStoryTime = async () => {
    if (!soundEnabled) { setMessage("Сочиняю..."); const story = await callGemini(`Напиши 1 короткое предложение доброй сказки на русском про котенка.`); setMessage(story.replace(/^["']|["']$/g, '')); return; }
    setMessage("Сочиняю...");
    const story = await callGemini(`Напиши 1 короткое предложение доброй сказки на русском про котенка.`);
    setMessage(story.replace(/^["']|["']$/g, '')); 
    playAudio(story);
  };

  const triggerQuiz = async (forcedCount) => {
    const currentCount = forcedCount !== undefined ? forcedCount : wordsTypedCount;
    // MATH
    if (currentCount > 0 && currentCount % 7 === 0) {
        const problem = generateMathProblem(level);
        if (problem) {
           setIsQuizMode(true);
           setWordAudioUrl(null);
           setCurrentWord(problem.a);
           setMessage(`Сколько будет ${problem.q}?`);
           setCurrentCategory('QUIZ'); 
           setTypedChars('');
           setHintKey(null);
           wordStartTimeRef.current = Date.now();
           setWaitingForConfirmation(false);
           return;
        }
    }
    // QUIZ
    const categories = CATEGORY_ORDER.filter(c => c !== 'COMMANDS');
    const randomCat = categories[Math.floor(Math.random() * categories.length)];
    const words = WORD_DATABASE[randomCat];
    const targetWord = words[Math.floor(Math.random() * words.length)];
    
    // Fallback if not quiz time
    if (!(currentCount > 0 && currentCount % 5 === 0)) return false; 

    setAiLoading(true);
    setIsQuizMode(true);
    setTypedChars('');
    setHintKey(null);
    setCurrentWord(targetWord);
    const prompt = `Ты играешь с ребенком 5-7 лет. Загадай очень простую и очевидную загадку на русском языке про: "${targetWord}". Ответ не пиши. Только загадку. Максимум 10 слов.`;
    try {
       const question = await callGemini(prompt);
       setMessage(question);
       setCurrentCategory('QUIZ');
       wordStartTimeRef.current = Date.now();
       setWaitingForConfirmation(false);
    } catch (e) { pickWord('COMMANDS'); } finally { setAiLoading(false); }
  };

  const pickWord = useCallback(async (category, customWord = null) => {
    let nextWord = '';
    if (customWord) {
      nextWord = customWord.toUpperCase();
      setCurrentCategory('CUSTOM');
    } else {
      const allWords = WORD_DATABASE[category];
      let maxLength = 100;
      if (level === 'baby') maxLength = 3;
      else if (level === 'kitten') maxLength = 3;
      else if (level === 'teen') maxLength = 4;
      else if (level === 'adult') maxLength = 6;
      let filteredWords = allWords.filter(w => w.length <= maxLength);
      if (filteredWords.length === 0) filteredWords = allWords.filter(w => w.length <= 3);
      if (filteredWords.length === 0) filteredWords = allWords;
      nextWord = filteredWords[Math.floor(Math.random() * filteredWords.length)];
      setCurrentCategory(category);
    }
    
    setCurrentWord(nextWord);
    setTypedChars('');
    setHintKey(null);
    wordStartTimeRef.current = Date.now();
    setCatAction('idle');
    setIsQuizMode(false);
    setWaitingForConfirmation(false);
    setMessage("Печатай слово!");
  }, [level]);

  useEffect(() => {
    if (!currentWord && !waitingForConfirmation) pickWord('COMMANDS');
  }, [currentWord, waitingForConfirmation, pickWord]);

  useEffect(() => {
    const decayInterval = setInterval(() => {
      if (waitingForConfirmation || isRewardTimerActive) return; 
      setStats(prev => ({
        hunger: Math.max(0, prev.hunger - 0.5),
        sleep: Math.max(0, prev.sleep - 0.2),
        clean: Math.max(0, prev.clean - 0.4),
        happiness: Math.max(0, prev.happiness - 0.5),
        intelligence: Math.max(0, prev.intelligence - 0.3) 
      }));
      if (Math.random() < 0.1 && catAction === 'idle') {
        setCatAction('blink');
        setTimeout(() => setCatAction('idle'), 200);
      }
    }, 5000);
    return () => clearInterval(decayInterval);
  }, [waitingForConfirmation, catAction, isRewardTimerActive]);

  useEffect(() => {
    if (!currentWord || waitingForConfirmation) return;
    const nextChar = currentWord[typedChars.length];
    const hintTimer = setTimeout(() => { setHintKey(nextChar); }, 3000); 
    return () => clearTimeout(hintTimer);
  }, [typedChars, currentWord, waitingForConfirmation]);

  useEffect(() => {
    let newLevel = 'baby';
    if (xp >= 1200) newLevel = 'smart';
    else if (xp >= 600) newLevel = 'adult';
    else if (xp >= 300) newLevel = 'teen';
    else if (xp >= 100) newLevel = 'kitten';
    if (newLevel !== level) {
      setLevel(newLevel);
      setShowLevelUp(true);
      setTimeout(() => setShowLevelUp(false), 3000);
    }
  }, [xp, level]);

  const handleNextWord = useCallback(() => {
    const newCount = wordsTypedCount + 1;
    setWordsTypedCount(newCount);
    if (newCount > 0 && newCount % 7 === 0) {
        triggerQuiz(newCount);
    } else if (newCount > 0 && newCount % 5 === 0 && !isQuizMode) {
      triggerQuiz(newCount);
    } else {
      let nextIndex = currentCategoryIndex;
      if (CATEGORY_ORDER.includes(currentCategory)) {
         nextIndex = (currentCategoryIndex + 1) % CATEGORY_ORDER.length;
         setCurrentCategoryIndex(nextIndex);
         pickWord(CATEGORY_ORDER[nextIndex]);
      } else {
         pickWord(CATEGORY_ORDER[0]);
         setCurrentCategoryIndex(0);
      }
    }
  }, [wordsTypedCount, currentCategoryIndex, isQuizMode, pickWord, currentCategory]);

  const resetCurrentWord = () => {
      setTypedChars('');
      setHintKey(null);
      setCombo(0);
      setWaitingForConfirmation(false); 
      window.speechSynthesis.cancel();
  };

  const handleVirtualKeyPress = (char) => {
      if (!isMobileMode && !waitingForConfirmation) return; 
      if (char === '3') { resetCurrentWord(); return; }
      if (char === 'Enter') { if (waitingForConfirmation) handleNextWord(); return; }
      if (waitingForConfirmation) return;
      if (!currentWord) return;
      const nextChar = currentWord[typedChars.length];
      if (char === nextChar) {
          const newTyped = typedChars + char;
          setTypedChars(newTyped);
          setLastInteractionTime(Date.now());
          setHintKey(null);
          if (newTyped === currentWord) completeWord();
      } else {
          setCombo(0);
      }
  };

  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === '1' && soundEnabled && currentWord) { playAudio(currentWord); return; }
      if (e.key === '2' && soundEnabled && message) { playAudio(message); return; }
      if (e.key === '3') { handleRecordToggle(); return; } 
      if (e.key === '4' || e.key === 'Escape') { resetCurrentWord(); return; }
      if (waitingForConfirmation && e.key === 'Enter') { handleNextWord(); return; }
      if (showCustomInput || waitingForConfirmation) return; 
      if (!currentWord) return;
      
      const key = e.key.toUpperCase();
      const nextChar = currentWord[typedChars.length];
      if (e.key === ' ' && nextChar === ' ') {
          e.preventDefault();
          const newTyped = typedChars + ' ';
          setTypedChars(newTyped);
          setLastInteractionTime(Date.now());
          setHintKey(null);
          if (newTyped === currentWord) completeWord();
          return;
      }
      if (key === nextChar) {
        const newTyped = typedChars + key;
        setTypedChars(newTyped);
        setLastInteractionTime(Date.now());
        setHintKey(null);
        if (newTyped === currentWord) completeWord();
      } else {
        if (key.length === 1 && /[А-ЯЁ0-9]/.test(key)) setCombo(0);
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [currentWord, typedChars, showCustomInput, waitingForConfirmation, handleNextWord, soundEnabled, message, isRecording]);

  const completeWord = () => {
    const timeTaken = (Date.now() - wordStartTimeRef.current) / 1000;
    const lengthBonus = Math.max(0, (currentWord.length - 3) * 5);
    let gainedXp = 10 + lengthBonus;
    if (timeTaken < 5 && !hintKey) { gainedXp += 5; setCombo(prev => prev + 1); setMessage(`СУПЕР! +${gainedXp} XP`); } 
    else { setMessage(`МОЛОДЕЦ! +${gainedXp} XP`); }

    if (soundEnabled && (wordsTypedCount + 1) % 11 === 0) {
        const randomMotivation = MOTIVATIONS[Math.floor(Math.random() * MOTIVATIONS.length)];
        setMessage(randomMotivation);
        playAudio(randomMotivation);
    }
    if (isRewardMode) {
        const rewardBonus = currentWord.length >= 6 ? 15 : 10;
        setRewardSeconds(prev => prev + rewardBonus);
        setSessionWordCount(prev => prev + 1);
    }
    setXp(prev => prev + gainedXp);
    updateCatState(currentCategory, currentWord);
    setWaitingForConfirmation(true);
  };

  const updateCatState = (category, word) => {
    let action = 'dance';
    const bonus = 20;
    if (BRAIN_CATEGORIES.includes(category) || category === 'QUIZ') {
         setStats(s => ({ ...s, intelligence: Math.min(100, s.intelligence + bonus) }));
         if (category !== 'QUIZ') action = 'smart';
    }
    if (category === 'HUNGER') action = 'eating';
    else if (category === 'SLEEP') action = 'sleeping';
    else if (category === 'CLEAN') action = 'bow'; 
    else if (category === 'LOVE') action = 'love';
    else if (category === 'COMMANDS' || category === 'QUIZ') {
        if (word === 'СИДЕТЬ') action = 'idle';
        else if (word === 'ЛЕЖАТЬ') action = 'lying';
        else if (word === 'ТАНЕЦ') action = 'dance';
        else if (word === 'КУВЫРОК' || word === 'ОБОРОТ') action = 'spin';
        else if (word === 'РЯДОМ') action = 'sway';
        else action = 'jump';
    }
    if (word === 'ТЫГЫДЫК') action = 'run';
    if (word === 'МЯУ') action = 'shake';
    setCatAction(action);
    const bonusStat = 20;
    switch (category) {
      case 'HUNGER': setStats(s => ({ ...s, hunger: Math.min(100, s.hunger + bonusStat) })); break;
      case 'SLEEP': setStats(s => ({ ...s, sleep: Math.min(100, s.sleep + bonusStat) })); break;
      case 'CLEAN': setStats(s => ({ ...s, clean: Math.min(100, s.clean + bonusStat) })); break;
      case 'HAPPINESS': setStats(s => ({ ...s, happiness: Math.min(100, s.happiness + bonusStat) })); break;
      case 'LOVE': setStats(s => ({ ...s, happiness: Math.min(100, s.happiness + bonusStat + 10) })); break;
      default: setStats(s => ({ ...s, happiness: Math.min(100, s.happiness + 10) }));
    }
  };

  const getKeyClass = (char) => {
    let baseClass = "m-0.5 rounded-md flex items-center justify-center font-bold shadow-md transition-all duration-200 select-none ";
    const sizeStyle = { width: `${2.5 * kbScale}rem`, height: `${2.5 * kbScale}rem`, fontSize: `${1.2 * kbScale}rem` };
    if (waitingForConfirmation) return { className: baseClass + "bg-gray-100 text-gray-400 cursor-default", style: sizeStyle };
    const isNext = currentWord && currentWord[typedChars.length] === char;
    if (isMobileMode) baseClass += "cursor-pointer active:scale-95 "; else baseClass += "cursor-default ";
    let colorClass = "bg-white text-gray-700 hover:bg-gray-100";
    if (hintKey === char) colorClass = "bg-yellow-300 ring-4 ring-yellow-500 animate-pulse scale-110 text-black";
    else if (isNext && !isMobileMode) colorClass = "bg-blue-100 border-2 border-blue-500 text-blue-900";
    return { className: baseClass + colorClass, style: sizeStyle };
  };

  const handleMenuClick = (category) => {
    setWaitingForConfirmation(false);
    pickWord(category);
    setMessage("Печатай!");
  };

  const handleCustomWordSubmit = (e) => {
    e.preventDefault();
    const word = customInputValue.trim();
    if (word.length > 0) {
        setCustomHistory(prev => [word, ...prev.filter(w => w !== word)].slice(0, 10));
        pickWord('CUSTOM', word);
        setCustomInputValue('');
        setShowCustomInput(false);
        setMessage("Твоё слово!");
    }
  };

  const toggleSound = () => {
      const newState = !soundEnabled;
      setSoundEnabled(newState);
      if (!newState) {
          window.speechSynthesis.cancel();
      }
  };

  const getStatColor = (val) => val > 70 ? 'bg-green-500' : val > 30 ? 'bg-yellow-400' : 'bg-red-500';

  return (
    <div className="min-h-screen bg-blue-50 font-sans select-none flex flex-col items-center p-2 overflow-hidden">
      
      <input type="file" ref={fileInputRef} onChange={handleImportFile} className="hidden" accept=".json" />

      {/* HELP MODAL */}
      {showHelp && (
          <div className="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
              <div className="bg-white rounded-3xl p-6 max-w-md w-full shadow-2xl relative">
                  <button onClick={() => setShowHelp(false)} className="absolute top-4 right-4 p-2 bg-gray-100 rounded-full hover:bg-gray-200"><X className="w-6 h-6"/></button>
                  <h2 className="text-2xl font-bold text-purple-600 mb-4 flex items-center"><HelpCircle className="w-8 h-8 mr-2"/> Помощь</h2>
                  <div className="space-y-3 text-sm text-gray-700 overflow-y-auto max-h-[60vh] pr-2">
                      <p>🐱 <b>Тайпинг-Котик</b> — игра для обучения печати!</p>
                      <ul className="list-disc pl-5 space-y-1">
                          <li><b>Печатай слова:</b> Нажимай буквы, чтобы кормить котика.</li>
                          <li><b>Рост:</b> Котик растет от Малыша до Умного Кота!</li>
                          <li><b>Загадки и Математика:</b> Появляются регулярно, чтобы развивать ум (шкала Интеллекта).</li>
                          <li><b>Награда 🎁:</b> Включи режим тренировки, копи секунды за слова, а потом трать их на отдых с таймером!</li>
                          <li><b>Звук 🔊:</b> Нажми 1 или 2, чтобы услышать слово или загадку.</li>
                          <li><b>Свой голос 🎤:</b> Запиши, как ты говоришь слово!</li>
                          <li><b>Шкафчик 🗄️:</b> Слева есть темы слов (Животные, Космос...). Выбирай, что учить!</li>
                      </ul>
                      <p className="text-green-600 font-bold mt-4">Удачи! 🚀</p>
                  </div>
              </div>
          </div>
      )}

      <div className="flex flex-row w-full max-w-7xl h-full gap-4 pt-2 relative z-10">
          
          <div className="hidden md:flex flex-col gap-2 w-32 min-w-[120px]">
              <div className="bg-white rounded-2xl shadow-lg p-2 flex flex-col items-center gap-2">
                  <span className="text-xs font-bold text-gray-400 uppercase">Шкафчик</span>
                  {CABINET_CATEGORIES.map(cat => (
                      <button key={cat} onClick={() => handleMenuClick(cat)} className={`w-full py-2 rounded-lg font-bold flex flex-col items-center text-xs transition ${cat === 'ANIMALS' ? 'bg-amber-100 text-amber-800 hover:bg-amber-200' : cat === 'PROFESSIONS' ? 'bg-slate-100 text-slate-800 hover:bg-slate-200' : cat === 'EMOTIONS' ? 'bg-yellow-100 text-yellow-800 hover:bg-yellow-200' : cat === 'NATURE' ? 'bg-green-100 text-green-800 hover:bg-green-200' : cat === 'HOUSE' ? 'bg-blue-100 text-blue-800 hover:bg-blue-200' : 'bg-rose-100 text-rose-800 hover:bg-rose-200'}`}>
                          {cat === 'ANIMALS' && <Dog className="w-6 h-6 mb-1"/>}
                          {cat === 'PROFESSIONS' && <Briefcase className="w-6 h-6 mb-1"/>}
                          {cat === 'EMOTIONS' && <Smile className="w-6 h-6 mb-1"/>}
                          {cat === 'NATURE' && <Trees className="w-6 h-6 mb-1"/>}
                          {cat === 'HOUSE' && <Home className="w-6 h-6 mb-1"/>}
                          {cat === 'BODY' && <Eye className="w-6 h-6 mb-1"/>}
                          {cat === 'ANIMALS' ? 'Животные' : cat === 'PROFESSIONS' ? 'Профессии' : cat === 'EMOTIONS' ? 'Эмоции' : cat === 'NATURE' ? 'Природа' : cat === 'HOUSE' ? 'Дом' : 'Тело'}
                      </button>
                  ))}
              </div>
          </div>

          <div className="flex flex-col flex-1 items-center">

              <div className="w-full flex justify-between items-start">
                {isRewardTimerActive && (
                    <div className="absolute inset-0 bg-black/80 z-50 flex flex-col items-center justify-center text-white rounded-3xl">
                        <h2 className="text-4xl font-bold mb-4 animate-pulse">ВРЕМЯ НАГРАДЫ!</h2>
                        <div className="text-9xl font-mono font-bold mb-8 bg-gray-800 px-12 py-4 rounded-2xl shadow-2xl border-4 border-yellow-400">
                            {formatTime(rewardSeconds)}
                        </div>
                        <div className="flex gap-6">
                            {!isTimerRunning ? (
                                <button onClick={() => setIsTimerRunning(true)} className="bg-green-500 hover:bg-green-600 p-6 rounded-full transition transform hover:scale-110"><Play className="w-12 h-12"/></button>
                            ) : (
                                <button onClick={() => setIsTimerRunning(false)} className="bg-yellow-500 hover:bg-yellow-600 p-6 rounded-full transition transform hover:scale-110"><Pause className="w-12 h-12"/></button>
                            )}
                            <button onClick={() => setIsRewardTimerActive(false)} className="bg-red-500 hover:bg-red-600 p-6 rounded-full transition transform hover:scale-110"><StopCircle className="w-12 h-12"/></button>
                        </div>
                    </div>
                )}

                <div className="bg-white rounded-2xl shadow-lg p-3 flex flex-col gap-2 w-[25%] min-w-[200px]">
                    <div className="flex items-center gap-2">
                        <div className="bg-purple-100 p-2 rounded-lg text-sm font-bold text-purple-700 whitespace-nowrap">
                            {level === 'baby' ? '👶 Малыш' : level === 'kitten' ? '🐱 Котенок' : level === 'teen' ? '😼 Подросток' : level === 'adult' ? '🦁 Кот' : '🎩 Умный'}
                        </div>
                        <button onClick={() => setShowHelp(true)} className="p-2 bg-yellow-100 text-yellow-600 rounded-full hover:bg-yellow-200" title="Помощь"><HelpCircle className="w-4 h-4"/></button>
                    </div>
                    <div className="flex justify-between items-center">
                        <div>
                            <span className="text-xs text-gray-500 block">Опыт (XP)</span>
                            <span className="font-bold text-purple-600 text-lg">{xp}</span>
                        </div>
                        <div className="flex gap-1">
                            <button onClick={handleExport} className="px-2 py-1 bg-blue-50 text-blue-600 rounded text-xs font-bold hover:bg-blue-100">Сохранить</button>
                            <button onClick={handleImportClick} className="px-2 py-1 bg-green-50 text-green-600 rounded text-xs font-bold hover:bg-green-100">Загрузить</button>
                        </div>
                    </div>
                </div>

                <div className="bg-white rounded-2xl shadow-lg p-3 flex gap-1 w-[45%] min-w-[320px] justify-around relative">
                    <div className="flex flex-col items-center"><Fish className="w-4 h-4 text-red-500 mb-1" /><div className="w-2 h-10 bg-gray-200 rounded-full overflow-hidden flex flex-col justify-end"><div className={`w-full transition-all duration-1000 ${getStatColor(stats.hunger)}`} style={{ height: `${stats.hunger}%` }} /></div></div>
                    <div className="flex flex-col items-center"><Heart className="w-4 h-4 text-pink-500 mb-1" /><div className="w-2 h-10 bg-gray-200 rounded-full overflow-hidden flex flex-col justify-end"><div className={`w-full transition-all duration-1000 ${getStatColor(stats.happiness)}`} style={{ height: `${stats.happiness}%` }} /></div></div>
                    <div className="flex flex-col items-center"><BedDouble className="w-4 h-4 text-blue-500 mb-1" /><div className="w-2 h-10 bg-gray-200 rounded-full overflow-hidden flex flex-col justify-end"><div className={`w-full transition-all duration-1000 ${getStatColor(stats.sleep)}`} style={{ height: `${stats.sleep}%` }} /></div></div>
                    <div className="flex flex-col items-center"><ShowerHead className="w-4 h-4 text-cyan-500 mb-1" /><div className="w-2 h-10 bg-gray-200 rounded-full overflow-hidden flex flex-col justify-end"><div className={`w-full transition-all duration-1000 ${getStatColor(stats.clean)}`} style={{ height: `${stats.clean}%` }} /></div></div>
                    <div className="flex flex-col items-center"><Brain className="w-4 h-4 text-purple-500 mb-1" /><div className="w-2 h-10 bg-gray-200 rounded-full overflow-hidden flex flex-col justify-end"><div className={`w-full transition-all duration-1000 ${getStatColor(stats.intelligence)}`} style={{ height: `${stats.intelligence}%` }} /></div></div>
                </div>
              </div>

              <div className="relative -mt-4 z-0 flex justify-center items-center gap-8 mb-2 w-full">
                  
                  <div className="w-40 flex justify-end">
                      {isRewardMode ? (
                        <div className="bg-white px-3 py-2 rounded-xl shadow-lg border-2 border-orange-200 text-gray-700 animate-fade-in-up">
                            <div className="text-center">
                                <div className="text-xs text-orange-500 font-bold uppercase mb-1 animate-pulse">Тренировка!</div>
                                <div className="text-[10px] text-gray-500">Слов: <span className="font-bold text-black">{sessionWordCount}</span></div>
                                <div className="text-base font-mono font-bold text-green-600 mt-1">+{formatTime(rewardSeconds)}</div>
                            </div>
                        </div>
                      ) : (
                          <div className="w-40"></div>
                      )}
                  </div>

                  <div className="relative flex flex-col items-center justify-center">
                      {showLevelUp && (<div className="absolute -top-10 z-50 pointer-events-none"><div className="bg-yellow-400 text-white font-bold py-2 px-6 rounded-full shadow-xl animate-bounce">НОВЫЙ УРОВЕНЬ! 🌟</div></div>)}
                      <CatAvatar mood={stats.happiness > 50 ? 'happy' : 'sad'} action={catAction} stage={level} currentWord={currentWord} category={currentCategory} />
                  </div>
                  
                  <div className="w-64 min-h-[80px] flex items-center">
                    <div className="bg-white w-full px-4 py-3 rounded-2xl rounded-tl-none shadow-lg border-2 border-purple-100 text-base text-gray-700 animate-fade-in-up leading-tight relative">
                        <div className="absolute top-4 -left-2 w-4 h-4 bg-white border-l-2 border-b-2 border-purple-100 transform rotate-45"></div>
                        {aiLoading ? (
                            <div className="flex space-x-1 justify-center py-2"><div className="w-2 h-2 bg-purple-400 rounded-full animate-bounce"></div><div className="w-2 h-2 bg-purple-400 rounded-full animate-bounce delay-75"></div><div className="w-2 h-2 bg-purple-400 rounded-full animate-bounce delay-150"></div></div>
                        ) : (
                        <>
                        <div className="flex justify-between items-start mb-1">
                            <span className="font-bold text-purple-500 block text-xs uppercase">{isQuizMode ? (wordsTypedCount % 7 === 0 ? <Calculator className="w-4 h-4 inline mr-1"/> : "Загадка:") : "Мяу!"}</span>
                            {soundEnabled && (<button onClick={() => playAudio(message)} className={`p-1 rounded-full transition ${isPlaying ? 'bg-purple-100 text-purple-600' : 'hover:bg-purple-50 text-gray-300'}`}><Volume2 className="w-4 h-4" /></button>)}
                        </div>
                        <div className="break-words">{message}</div>
                        </>
                        )}
                    </div>
                  </div>
              </div>

              {/* CONTROLS & AI */}
              <div className="flex justify-center gap-4 mb-2 z-20">
                  <button onClick={handleRewardToggle} className={`p-2 rounded-full shadow transition border-2 ${isRewardMode ? 'bg-orange-100 border-orange-400 animate-pulse' : 'bg-white border-gray-200 hover:bg-green-50'}`} title={isRewardMode ? "Закончить тренировку" : "Начать тренировку за награду"}>
                    {isRewardMode ? <StopCircle className="w-5 h-5 text-orange-600"/> : <Gift className="w-5 h-5 text-green-600"/>}
                  </button>

                  <button onClick={toggleSound} className={`p-2 rounded-full shadow transition border ${soundEnabled ? 'bg-green-100 border-green-200' : 'bg-red-100 border-red-200'}`}><Volume2 className="w-5 h-5"/></button>
                  <button onClick={() => setIsMobileMode(!isMobileMode)} className={`p-2 rounded-full shadow transition border ${isMobileMode ? 'bg-purple-100 border-purple-200' : 'bg-white'}`}><Smartphone className="w-5 h-5"/></button>
                  <button onClick={handleCatThought} disabled={aiLoading} className="p-2 rounded-full shadow bg-white hover:bg-purple-50"><MessageCircle className="w-5 h-5 text-purple-500"/></button>
                  <button onClick={handleStoryTime} disabled={aiLoading} className="p-2 rounded-full shadow bg-white hover:bg-blue-50"><BookOpen className="w-5 h-5 text-blue-500"/></button>
              </div>

              {/* WORD INPUT */}
              {showCustomInput ? (
                    <div className="bg-white px-8 py-4 rounded-2xl shadow-xl border-b-8 border-purple-200 mb-2 flex flex-col items-center w-full max-w-lg z-30">
                        <form onSubmit={handleCustomWordSubmit} className="flex w-full gap-2">
                            <input type="text" autoFocus value={customInputValue} onChange={(e) => setCustomInputValue(e.target.value)} placeholder="СЛОВО" className="flex-1 text-2xl border-2 border-gray-300 rounded-lg px-4 py-2 uppercase font-mono" />
                            <button type="submit" className="bg-purple-500 text-white px-4 rounded-lg font-bold">OK</button>
                            <button type="button" onClick={() => setShowCustomInput(false)} className="bg-gray-200 px-4 rounded-lg font-bold">X</button>
                        </form>
                    </div>
                ) : (
                    <div className={`relative bg-white px-8 py-4 rounded-2xl shadow-xl border-b-8 ${isQuizMode ? 'border-purple-400 ring-4 ring-purple-100' : 'border-gray-200'} mb-2 flex flex-col items-center transition-all min-w-[300px]`}>
                    <div className="flex items-center gap-4">
                        {soundEnabled && (<button onClick={handleRecordToggle} className={`p-2 rounded-full transition ${isRecording ? 'bg-red-100 text-red-600 animate-pulse' : 'hover:bg-gray-100 text-gray-400'}`}>{isRecording ? <Square className="w-5 h-5 fill-current" /> : <Mic className="w-5 h-5" />}</button>)}
                        <button onClick={resetCurrentWord} className="p-2 rounded-full hover:bg-gray-100 text-gray-400 transition"><RotateCcw className="w-5 h-5" /></button>

                        <div className="flex space-x-1 text-6xl font-mono font-bold tracking-wider">
                            {waitingForConfirmation ? (
                                <span className="text-green-500">{formatSyllables(currentWord)}</span>
                            ) : (
                                currentWord.split('').map((char, index) => {
                                    let colorClass = "text-gray-300";
                                    if (index < typedChars.length) colorClass = "text-green-500";
                                    else if (index === typedChars.length) colorClass = "text-black animate-pulse border-b-4 border-blue-400";
                                    return (<span key={index} className={`${colorClass} transition-colors duration-200`}>{char === ' ' ? '\u00A0' : char}</span>);
                                })
                            )}
                        </div>
                        
                        {soundEnabled && !waitingForConfirmation && (
                            <button onClick={() => playAudio(currentWord)} className="p-3 rounded-full hover:bg-blue-50 text-blue-600 transition">
                                {isPlaying ? <Loader2 className="w-6 h-6 animate-spin text-gray-400"/> : <Volume2 className="w-6 h-6"/>}
                            </button>
                        )}
                        
                        {waitingForConfirmation && (
                            <button onClick={handleNextWord} className="ml-4 bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-4 rounded-xl shadow-xl flex items-center animate-fade-in-up"><ArrowRight className="w-8 h-8" /></button>
                        )}
                    </div>
                    </div>
                )}

              {/* MENU */}
              <div className="flex space-x-2 mb-2 flex-wrap justify-center">
                <button onClick={() => handleMenuClick('HUNGER')} className="px-3 py-1 bg-orange-100 text-orange-700 rounded-lg hover:bg-orange-200 font-bold flex items-center"><Fish className="w-4 h-4 mr-1"/>ЕДА</button>
                <button onClick={() => handleMenuClick('LOVE')} className="px-3 py-1 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 font-bold flex items-center"><Heart className="w-4 h-4 mr-1"/>ЛЮБОВЬ</button>
                <button onClick={() => handleMenuClick('SLEEP')} className="px-3 py-1 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 font-bold flex items-center"><BedDouble className="w-4 h-4 mr-1"/>СОН</button>
                <button onClick={() => handleMenuClick('CLEAN')} className="px-3 py-1 bg-cyan-100 text-cyan-700 rounded-lg hover:bg-cyan-200 font-bold flex items-center"><ShowerHead className="w-4 h-4 mr-1"/>МЫТЬ</button>
                <button onClick={() => handleMenuClick('HAPPINESS')} className="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-lg hover:bg-yellow-200 font-bold flex items-center"><Dribbble className="w-4 h-4 mr-1"/>ИГРА</button>
                <button onClick={() => setShowCustomInput(true)} className="px-3 py-1 bg-purple-100 text-purple-700 rounded-lg hover:bg-purple-200 font-bold flex items-center"><PenTool className="w-4 h-4 mr-1"/>Своё</button>
              </div>

              <div className="w-full max-w-4xl flex justify-end px-4 mb-1 gap-2">
                    <button onClick={() => setKbScale(Math.max(0.5, kbScale - 0.1))} className="p-1 bg-gray-200 rounded hover:bg-gray-300"><ZoomOut className="w-4 h-4"/></button>
                    <button onClick={() => setKbScale(Math.min(2.0, kbScale + 0.1))} className="p-1 bg-gray-200 rounded hover:bg-gray-300"><ZoomIn className="w-4 h-4"/></button>
              </div>

              {/* KEYBOARD */}
              <div className="bg-gray-200 p-2 rounded-xl shadow-inner select-none transition-all w-full max-w-5xl flex flex-col items-center">
                {KEYBOARD_LAYOUT.map((row, rIndex) => (
                    <div key={rIndex} className="flex justify-center mb-1 w-full">
                    {row.map((char) => {
                        const kProps = getKeyClass(char);
                        return (<div key={char} className={kProps.className} style={kProps.style} onClick={() => isMobileMode ? handleVirtualKeyPress(char) : null}>{char}</div>)
                    })}
                    </div>
                ))}
                <div className="flex justify-center mt-2 w-full">
                    <div onClick={() => isMobileMode ? handleVirtualKeyPress(' ') : null} className={`rounded-md flex items-center justify-center text-gray-400 bg-white shadow-md ${currentWord.includes(' ') && currentWord[typedChars.length] === ' ' ? 'bg-blue-100 border-blue-500' : ''} ${isMobileMode ? 'cursor-pointer active:scale-95' : ''}`} style={{ width: `${16 * kbScale}rem`, height: `${2.5 * kbScale}rem`, fontSize: `${1 * kbScale}rem` }}>ПРОБЕЛ</div>
                </div>
              </div>
          </div>
      </div>
    </div>
  );
};

export default App;